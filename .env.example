# TAIOS frontend environment variables

NEXT_PUBLIC_APP_NAME=TAIOS
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# SECURITY NOTE:
# Only NEXT_PUBLIC_ variables are exposed to the browser.
# Do NOT put private keys in frontend env files.

# Never expose these in frontend:
# OPENAI_API_KEY
# DATABASE_URL
# JWT_SECRET
# SMTP_PASSWORD
# PAYMENT_SECRET_KEY# TAIOS frontend environment variables

NEXT_PUBLIC_APP_NAME=TAIOS
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Do NOT put private keys here.
# Never expose these in frontend:
# OPENAI_API_KEY
# DATABASE_URL
# JWT_SECRET
# SMTP_PASSWORD
# PAYMENT_SECRET_KEY
